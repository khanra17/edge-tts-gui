{
    "name": "edge-speak",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=26.12.0",
        "npm": ">=11.20.0"
    },
    "scripts": {
        "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
