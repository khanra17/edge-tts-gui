{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Edge Speak",
    "version": "0.1.0",
    "identifier": "com.edge.tts.gui.rust",
    "build": {
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build",
        "devUrl": "http://127.0.0.1:1420",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Edge Speak",
                "width": 740,
                "height": 580,
                "minWidth": 460,
                "minHeight": 480,
                "resizable": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
        }
    },
    "bundle": {
        "active": false,
        "targets": [],
        "icon": ["icons/icon.ico"]
    }
}
